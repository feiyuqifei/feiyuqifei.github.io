---
/**
 * 分页导航。
 *
 * URL 约定：
 *   第 1 页 = 列表根路径本身（/tech/）
 *   第 N 页 = /tech/page/N/
 * 这样第一页的链接最干净，也符合搜索引擎的常规预期。
 */
interface Props {
  current: number;
  total: number;
  /** 列表根路径，不含结尾斜杠，例如 /tech 或 /tags/安全 */
  base: string;
  /** 最多显示多少个页码按钮（超出用省略号） */
  window?: number;
}

const { current, total, base, window: win = 5 } = Astro.props;

/** 第 1 页落在 base，其余落在 base/page/N */
function hrefFor(page: number): string {
  return page === 1 ? `${base}/` : `${base}/page/${page}/`;
}

// 计算窗口内的页码，必要时用省略号占位
function pageWindow(): Array<number | '...'> {
  if (total <= win + 2) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  const half = Math.floor(win / 2);
  let start = Math.max(2, current - half);
  let end = Math.min(total - 1, start + win - 1);
  // 靠近结尾时向前补齐，避免窗口宽度跳动
  start = Math.max(2, Math.min(start, total - win));

  const items: Array<number | '...'> = [1];
  if (start > 2) items.push('...');
  for (let p = start; p <= end; p++) items.push(p);
  if (end < total - 1) items.push('...');
  items.push(total);
  return items;
}

const pages = total > 1 ? pageWindow() : [];
---

{
  pages.length > 0 && (
    <nav class="pagination" aria-label="分页导航">
      {current > 1 ? (
        <a href={hrefFor(current - 1)} rel="prev" aria-label="上一页">
          ← 上一页
        </a>
      ) : (
        <span aria-hidden="true" style="opacity:.4">
          ← 上一页
        </span>
      )}

      {pages.map((p) =>
        p === '...' ? (
          <span aria-hidden="true">…</span>
        ) : p === current ? (
          <span class="current" aria-current="page">
            {p}
          </span>
        ) : (
          <a href={hrefFor(p)} aria-label={`第 ${p} 页`}>
            {p}
          </a>
        )
      )}

      {current < total ? (
        <a href={hrefFor(current + 1)} rel="next" aria-label="下一页">
          下一页 →
        </a>
      ) : (
        <span aria-hidden="true" style="opacity:.4">
          下一页 →
        </span>
      )}
    </nav>
  )
}
