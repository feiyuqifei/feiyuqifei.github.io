---
/**
 * 竞赛页。
 *
 * 定位不是"参赛履历"，而是**竞赛信息库**：把各类竞赛的报名时间、地点、
 * 主办方、官网入口集中记在一处，报名或查资料时不用每次重新搜索。
 *
 * 数据全部来自 src/consts.ts 的 COMPETITIONS，页面本身不含内容。
 *
 * 两级分组：
 *   第一级 —— 板块（COMPETITION_GROUPS，目前只有「信息安全竞赛」）
 *   第二级 —— 报名月份（1~12 月，按时间先后排；拿不到月份的归入末尾）
 *
 * 为什么按"报名月份"而不是比赛时间排：
 *   报名时间才是你需要行动的那个时间点。比赛时间晚于报名，
 *   按比赛时间排会让你错过报名。
 */
import Layout from '../layouts/Layout.astro';
import {
  SITE,
  COMPETITIONS,
  COMPETITION_GROUPS,
  COMPETITION_RECORDS,
  type CompetitionItem,
  type CompetitionGroupKey,
} from '../consts';
import { withBase } from '../utils/url';
import { COMPETITION_TABS_SCRIPT } from '../scripts/competition-tabs';

/** 月份标签 */
const MONTH_NAMES = [
  '1 月', '2 月', '3 月', '4 月', '5 月', '6 月',
  '7 月', '8 月', '9 月', '10 月', '11 月', '12 月',
];

/** 按板块 → 月份两级分组 */
const groupKeys = Object.keys(COMPETITION_GROUPS) as CompetitionGroupKey[];

const sections = groupKeys
  .map((key) => {
    const items = COMPETITIONS.filter((c) => c.group === key);

    /* 有月份的按 1~12 排，无月份的排到末尾 */
    const withMonth = items
      .filter((c) => typeof c.month === 'number')
      .sort((a, b) => (a.month as number) - (b.month as number));
    const withoutMonth = items.filter((c) => typeof c.month !== 'number');

    /* 按月份聚合成桶，保持月份先后顺序 */
    const buckets: { month: number | null; label: string; items: CompetitionItem[] }[] = [];
    for (const item of withMonth) {
      const m = item.month as number;
      const last = buckets[buckets.length - 1];
      if (last && last.month === m) {
        last.items.push(item);
      } else {
        buckets.push({ month: m, label: MONTH_NAMES[m - 1] ?? `${m} 月`, items: [item] });
      }
    }
    if (withoutMonth.length > 0) {
      buckets.push({ month: null, label: '时间待确认', items: withoutMonth });
    }

    return { key, meta: COMPETITION_GROUPS[key], total: items.length, buckets };
  })
  .filter((s) => s.total > 0);

/**
 * 参赛记录按年份倒序分组（新的在前）。
 * 同一年内保持数组里的书写顺序，方便自己按时间线排。
 * 数据为空时返回空数组，页面据此显示填写说明而不是空白。
 */
const recordYears = (() => {
  const years = [...new Set(COMPETITION_RECORDS.map((r) => r.year))].sort((a, b) => b - a);
  return years.map((year) => ({
    year,
    items: COMPETITION_RECORDS.filter((r) => r.year === year),
  }));
})();
---

<Layout
  title="竞赛"
  description={`${SITE.name}的竞赛信息库：各类竞赛的报名时间、地点、主办方与官网入口，按报名月份归档。`}
  progress
>
  <header class="page-head">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={withBase('/')}>首页</a>
      <span> / </span>
      <span>竞赛</span>
    </nav>
    <h1>竞赛</h1>
    <p class="page-desc">
      两个视角：<strong>全年竞赛</strong>看有哪些比赛、什么时候报名；
      <strong>荣誉历史</strong>是已经打完的比赛和成绩。
    </p>
  </header>

  {/*
    标签切换而不是分成两个页面：
    两者是同一个人对竞赛的两个视角（面向未来 / 面向过去），
    分开会增加导航负担；合在一页又能各自保持完整。
    切换用真实的 tab 语义（role=tablist/tab/tabpanel + aria-selected），
    这样键盘和读屏软件都能正常用，且不依赖任何框架。
  */}
  <div class="comp-tabs" role="tablist" aria-label="竞赛视图">
    <button
      class="comp-tab is-active"
      role="tab"
      id="tab-yearly"
      aria-controls="panel-yearly"
      aria-selected="true"
      type="button"
    >
      全年竞赛
      <span class="comp-tab-count">{COMPETITIONS.length}</span>
    </button>
    <button
      class="comp-tab"
      role="tab"
      id="tab-records"
      aria-controls="panel-records"
      aria-selected="false"
      tabindex="-1"
      type="button"
    >
      荣誉历史
      <span class="comp-tab-count">{COMPETITION_RECORDS.length}</span>
    </button>
  </div>

  <div
    class="comp-panel"
    id="panel-yearly"
    role="tabpanel"
    aria-labelledby="tab-yearly"
  >
  {
    sections.length === 0 ? (
      /*
        空状态文案写给访客看，不暴露实现细节。
        早先这里写的是「数据在 src/consts.ts 的 COMPETITIONS 里，加一条就会
        出现在这里」—— 那是给维护者看的提示，访客看到只会困惑。
      */
      <div class="empty-state">
        <p class="empty-title">还没有收录竞赛</p>
        <p>竞赛信息正在整理中，稍后再来看看。</p>
      </div>
    ) : (
      sections.map((section) => (
        <section class="comp-section" aria-label={section.meta.name}>
          {/* ── 板块标题 ── */}
          <div class="comp-section-head">
            <h2 class="comp-section-title">{section.meta.name}</h2>
            <span class="comp-section-count">{section.total} 项</span>
          </div>
          <p class="comp-section-desc">{section.meta.desc}</p>

          {/* ── 按月份分桶 ── */}
          {section.buckets.map((bucket) => (
            <div class="comp-month" data-month={bucket.month ?? 'unknown'}>
              <div class="comp-month-head">
                <span class="comp-month-label">{bucket.label}</span>
                <span class="comp-month-line" aria-hidden="true"></span>
                <span class="comp-month-count">{bucket.items.length} 项</span>
              </div>

              <ul class="comp-list">
                {bucket.items.map((c: CompetitionItem) => (
                  <li class="comp-item">
                    <div class="comp-main">
                      <div class="comp-head">
                        <h3 class="comp-name">{c.name}</h3>
                        {c.status === 'open' && <span class="comp-badge is-open">报名中</span>}
                        {c.status === 'upcoming' && <span class="comp-badge is-upcoming">即将开始</span>}
                        {/*
                          月份可信度标记。
                          没查证过的月份必须显式标出来 —— 竞赛月份报错会让人
                          整年错过报名，不能让读者以为所有月份都一样可信。
                        */}
                        {typeof c.month === 'number' && !c.monthVerified && (
                          <span class="comp-badge is-unverified" title="该月份未查证，是按常见规律推断的，请以官网为准">
                            月份待核实
                          </span>
                        )}
                      </div>

                      {/* 报名与比赛时间 */}
                      {(c.registerAt || c.deadline || c.when) && (
                        <dl class="comp-fields">
                          {c.registerAt && (
                            <>
                              <dt>报名时间</dt>
                              <dd>{c.registerAt}</dd>
                            </>
                          )}
                          {c.deadline && (
                            <>
                              <dt>报名截止</dt>
                              <dd class="is-em">{c.deadline}</dd>
                            </>
                          )}
                          {c.when && (
                            <>
                              <dt>比赛时间</dt>
                              <dd>{c.when}</dd>
                            </>
                          )}
                          {c.location && (
                            <>
                              <dt>地点</dt>
                              <dd>{c.location}</dd>
                            </>
                          )}
                          {c.organizer && (
                            <>
                              <dt>主办方</dt>
                              <dd>{c.organizer}</dd>
                            </>
                          )}
                          {c.advisor && (
                            <>
                              <dt>指导方</dt>
                              <dd>{c.advisor}</dd>
                            </>
                          )}
                          {c.eligibility && (
                            <>
                              <dt>参赛资格</dt>
                              <dd>{c.eligibility}</dd>
                            </>
                          )}
                        </dl>
                      )}

                      {c.desc && <p class="comp-desc">{c.desc}</p>}

                      {/* 参考题解：自己的排在前面，别人的标注作者 */}
                      {c.writeups && c.writeups.length > 0 && (
                        <div class="comp-writeups">
                          <span class="comp-writeups-label">参考题解</span>
                          <ul class="comp-writeups-list">
                            {[...c.writeups]
                              .sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'local' ? -1 : 1))
                              .map((w) => (
                                <li>
                                  <a
                                    class={`comp-writeup is-${w.kind}`}
                                    href={w.kind === 'local' ? withBase(w.url) : w.url}
                                    {...(w.kind === 'external'
                                      ? { target: '_blank', rel: 'noopener noreferrer' }
                                      : {})}
                                  >
                                    <span class="comp-writeup-title">{w.title}</span>
                                    {w.author && <span class="comp-writeup-author">@{w.author}</span>}
                                    {w.note && <span class="comp-writeup-note">{w.note}</span>}
                                    <span class="comp-writeup-arrow" aria-hidden="true">
                                      {w.kind === 'local' ? '→' : '↗'}
                                    </span>
                                  </a>
                                </li>
                              ))}
                          </ul>
                        </div>
                      )}
                    </div>

                    {c.url && (
                      <a class="comp-link" href={c.url} target="_blank" rel="noopener noreferrer">
                        官网入口 ↗
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    )
  }

  <section style="margin-top:2.5rem" aria-label="说明">
    <div class="list-head">
      <h2>关于收录</h2>
    </div>
    <div class="prose" style="font-size:.95rem">
      <p>
        时间标的是<strong>最近一届的实际时间</strong>，用来推断「通常几月报名」。
        竞赛时间每年都会浮动，<strong>当届务必以官网为准</strong>。
        这也是每条都附链接的原因。
      </p>
      <p>
        带 <span class="comp-badge is-unverified">月份待核实</span> 标记的条目，
        月份<strong>是按常见规律推断的，没有查证过当届通知</strong>，可能就是错的。
        查证过的条目不加这个标记。宁可你多点一次官网，也不要让你按错月份去等报名。
      </p>
      <p>
        按报名月份归档而不是比赛时间：报名才是需要你行动的时间点，
        按比赛时间排容易错过报名。
      </p>
      <p>
        标注「时间待确认」的条目是暂时没查到可靠时间的，留在这里占位，查到后补上。
      </p>
    </div>
  </section>
  </div>

  {/* ────────── 荣誉历史 ────────── */}
  <div
    class="comp-panel"
    id="panel-records"
    role="tabpanel"
    aria-labelledby="tab-records"
    hidden
  >
    {
      recordYears.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">还没有记录参赛成绩</p>
          <p>成绩还在整理中，稍后再来看看。</p>
        </div>
      ) : (
        recordYears.map((group) => (
          <section class="comp-section" aria-label={`${group.year} 年`}>
            <div class="comp-section-head">
              <h2 class="comp-section-title">{group.year} 年</h2>
              <span class="comp-section-count">{group.items.length} 项</span>
            </div>

            <ul class="comp-list">
              {group.items.map((r) => (
                <li class="comp-item rec-item">
                  <div class="comp-main">
                    <div class="comp-head">
                      <h3 class="comp-name">{r.name}</h3>
                      {r.award && <span class="comp-badge is-award">{r.award}</span>}
                      {r.category && <span class="comp-badge">{r.category}</span>}
                    </div>

                    {(r.rank || (r.teammates && r.teammates.length > 0)) && (
                      <dl class="comp-fields">
                        {r.rank && (
                          <>
                            <dt>名次</dt>
                            <dd class="is-em">{r.rank}</dd>
                          </>
                        )}
                        {r.teammates && r.teammates.length > 0 && (
                          <>
                            <dt>队友</dt>
                            <dd>{r.teammates.join('、')}</dd>
                          </>
                        )}
                      </dl>
                    )}

                    {r.note && <p class="comp-desc">{r.note}</p>}
                  </div>

                  {r.certificate && (
                    <a
                      class="comp-link"
                      href={r.certificate}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      证书 / 公示 ↗
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</Layout>

<script is:inline set:html={COMPETITION_TABS_SCRIPT} />

<style>
  .comp-tabs {
    display: flex;
    gap: 0.4rem;
    margin-block: 1.4rem 1.8rem;
    border-bottom: 1px solid var(--border);
  }

  .comp-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border: none;
    background: none;
    color: var(--text-muted);
    font-size: 0.98rem;
    font-family: inherit;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .comp-tab:hover {
    color: var(--text);
  }

  .comp-tab.is-active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .comp-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm, 4px);
  }

  .comp-tab-count {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.05em 0.4em;
    border-radius: 999px;
    background: var(--bg-subtle);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }

  /* 荣誉标签的配色：与「月份待核实」的警示色区分开 */
  .comp-badge.is-award {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .empty-sub {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (width<=560px) {
    .comp-tab {
      padding: 0.5rem 0.7rem;
      font-size: 0.92rem;
    }
  }
</style>
