---
/**
 * 全站页脚：版权、站点标语、社交链接、访客统计。
 */
import { SITE, SOCIALS } from '../consts';
import { withBase } from '../utils/url';
import SiteStats from './SiteStats.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {SITE.name} · {SITE.tagline}</span>

    {/* 访客统计：数字到位后才显示，脚本被拦时不留下空壳 */}
    <SiteStats />

    <div class="footer-links">
      {
        SOCIALS.map((item) => (
          <a
            href={item.href.startsWith('http') ? item.href : withBase(item.href)}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            aria-label={item.name}
            title={item.name}
          >
            {item.icon === 'github' ? (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
              </svg>
            ) : (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
              </svg>
            )}
          </a>
        ))
      }
    </div>
  </div>
</footer>
