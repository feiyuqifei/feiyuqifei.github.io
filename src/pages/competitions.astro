---
/**
 * 竞赛页。
 *
 * 定位不是"参赛履历"，而是**竞赛信息库**：把各类竞赛的时间、主办方、
 * 官网入口集中记在一处，报名或查资料时不用每次重新搜索。
 *
 * 数据全部来自 src/consts.ts 的 COMPETITIONS，页面本身不含内容 ——
 * 增删竞赛只改配置，不用碰这个文件。
 *
 * 按状态分四组渲染，顺序即优先级：
 *   报名中   —— 最需要被看到，排最前
 *   即将开始 —— 时间已定但还没开放报名
 *   常年/待定 —— 按往届时间参考
 *   已结束   —— 留档，方便回看赛题
 */
import Layout from '../layouts/Layout.astro';
import { SITE, COMPETITIONS, type CompetitionItem } from '../consts';
import { withBase } from '../utils/url';

const GROUPS = [
  { key: 'open', title: '报名中', hint: '现在就能报', cls: 'is-open' },
  { key: 'upcoming', title: '即将开始', hint: '时间已定，尚未开放报名', cls: 'is-upcoming' },
  { key: 'recurring', title: '常年 / 时间待定', hint: '按往届时间作参考', cls: 'is-recurring' },
  { key: 'ended', title: '已结束', hint: '留档备查', cls: 'is-ended' },
] as const;

const grouped = GROUPS.map((g) => ({
  ...g,
  items: COMPETITIONS.filter((c) => c.status === g.key),
})).filter((g) => g.items.length > 0);

/** 按分类统计，用于顶部概览 */
const categories = [...new Set(COMPETITIONS.map((c) => c.category).filter(Boolean))] as string[];

/**
 * 从往届时间文本里提取年份，用于排序与展示。
 * 时间字段是自由文本（如"每年 5 月"），拿不到年份就返回 null。
 */
function yearOf(c: CompetitionItem): number | null {
  const m = /(19|20)\d{2}/.exec(c.when ?? c.deadline ?? '');
  return m ? Number(m[0]) : null;
}
---

<Layout
  title="竞赛"
  description={`${SITE.name}的竞赛信息库：各类竞赛的时间、主办方与官网入口。`}
  progress
>
  <header class="page-head">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={withBase('/')}>首页</a>
      <span> / </span>
      <span>竞赛</span>
    </nav>
    <h1>竞赛</h1>
    <p class="page-desc">
      这里放的是各类竞赛的信息：什么时候办、谁主办、考什么、从哪报名。
      目的是下次想报名或查资料时不用重新搜一遍。
    </p>
  </header>

  {
    COMPETITIONS.length === 0 ? (
      <div class="empty-state">
        <p class="empty-title">还没有收录竞赛</p>
        <p>
          数据在 <code>src/consts.ts</code> 的 <code>COMPETITIONS</code> 里，
          加一条就会出现在这里。
        </p>
      </div>
    ) : (
      <>
        {/* ── 概览 ── */}
        <div class="comp-summary">
          <span class="comp-total">共 {COMPETITIONS.length} 项</span>
          {categories.map((c: string) => (
            <span class="comp-cat">{c}</span>
          ))}
        </div>

        {/* ── 分组列表 ── */}
        {grouped.map((g) => (
          <section class="comp-group" aria-label={g.title}>
            <div class="list-head">
              <h2>{g.title}</h2>
              <span class="count">
                {g.items.length} 项 · {g.hint}
              </span>
            </div>

            <ul class="comp-list">
              {g.items.map((c: CompetitionItem) => {
                const y = yearOf(c);
                return (
                  <li class={`comp-item ${g.cls}`}>
                    <div class="comp-main">
                      <div class="comp-head">
                        <h3 class="comp-name">{c.name}</h3>
                        {c.category && <span class="comp-tag">{c.category}</span>}
                      </div>

                      {c.organizer && (
                        <p class="comp-meta">
                          <span class="comp-label">主办</span>
                          {c.organizer}
                        </p>
                      )}

                      {(c.when || c.deadline) && (
                        <p class="comp-meta">
                          <span class="comp-label">时间</span>
                          {c.when}
                          {c.deadline && <span class="comp-deadline">报名截止：{c.deadline}</span>}
                          {y && <span class="comp-year">{y}</span>}
                        </p>
                      )}

                      {c.desc && <p class="comp-desc">{c.desc}</p>}
                    </div>

                    {c.url && (
                      <a class="comp-link" href={c.url} target="_blank" rel="noopener noreferrer">
                        官网入口 ↗
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </>
    )
  }

  <section style="margin-top:3rem" aria-label="说明">
    <div class="list-head">
      <h2>关于收录</h2>
    </div>
    <div class="prose" style="font-size:.95rem">
      <p>
        竞赛时间每年都可能调整，这里记的主要是<strong>往届规律</strong>和官网入口。
        真要报名，以官网公告为准 —— 这也是每条都附链接的原因。
      </p>
      <p>
        收录标准只有一条：<strong>自己真会去看的</strong>。
        不做大而全的导航站，网上那种列表已经很多了，缺的是筛过一遍的。
      </p>
      <p>
        如果某条信息过期了，直接看官网确认即可；这个页面不追求实时同步。
      </p>
    </div>
  </section>
</Layout>
