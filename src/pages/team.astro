---
/**
 * 团队成员页。
 *
 * 定位：介绍队伍的指导老师、队长、现役队员与已毕业成员。
 * 与竞赛页「荣誉历史」的区别：那边是成绩，这边是人。
 *
 * 数据全部来自 src/consts.ts 的 TEAM_MEMBERS，页面本身不含内容。
 * 按 TEAM_ROLES 的顺序分组（指导老师 → 队长 → 队员 → 已毕业），
 * 组内按年份倒序（新的在前），没填年份的排在后面。
 *
 * 三处比常见团队页做得细的地方：
 *   1. 头像用姓名首字占位，不依赖图片文件 —— 头像是团队页最常见的
 *      坏点（第三方图床关站会让整页变成一排破图），首字占地永远有效。
 *      有图时也带 onerror 降级。
 *   2. 方向标签链到站内标签页。这是本站独有的优势：点「Misc」能直接
 *      看到该方向的题解与工具文章，而不只是一个死标签。
 *   3. 成员可关联站内文章：文章 frontmatter 的 author 等于该成员的
 *      name 或 handle 时，卡片上出现「本站文章 N 篇」入口。
 *      不需要额外维护映射表，填 author 即可。
 */
import Layout from '../layouts/Layout.astro';
import {
  TEAM_INFO,
  TEAM_MEMBERS,
  TEAM_ROLES,
  TEAM_NOTICES,
  RECRUITMENT,
  type TeamMember,
} from '../consts';
import { withBase } from '../utils/url';
import { formatDate } from '../utils/date';
import { getPublishedPosts, type PostEntry } from '../utils/render-posts';

const posts = await getPublishedPosts();

/** 公告按日期倒序（新的在前） */
const notices = [...TEAM_NOTICES].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

/** 统计每个成员在本站写了多少篇（按 author 匹配 name 或 handle） */
function postCountFor(m: TeamMember): number {
  return posts.filter((p: PostEntry) => {
    const a = (p.data.author ?? '').trim();
    if (!a) return false;
    return a === m.name || (!!m.handle && a === m.handle);
  }).length;
}

/** 组内排序：有年份的按年份倒序在前，没年份的按原名顺序在后 */
function byYearDesc(a: TeamMember, b: TeamMember): number {
  const ay = a.year ?? -Infinity;
  const by = b.year ?? -Infinity;
  if (ay !== by) return by - ay;
  return a.name.localeCompare(b.name, 'zh-CN');
}

const groups = TEAM_ROLES.map((role) => ({
  meta: role,
  items: TEAM_MEMBERS.filter((m) => m.role === role.key).sort(byYearDesc),
})).filter((g) => g.items.length > 0);

const total = TEAM_MEMBERS.length;
---

<Layout
  title="成员"
  description={`${TEAM_INFO.name}（${TEAM_INFO.school}）的团队介绍与成员：指导老师、队长、队员与已毕业成员。`}
>
  <header class="page-head">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={withBase('/')}>首页</a>
      <span> / </span>
      <span>成员</span>
    </nav>
    <h1>{TEAM_INFO.name}</h1>
    <p class="page-desc">
      {TEAM_INFO.school}的网络安全实验组，战队名 {TEAM_INFO.teamName}。
      下面是团队介绍、公告与成员名单。
    </p>
  </header>

  {/*
    团队介绍。
    放在成员名单之前：访客先要知道"这是个什么团队"，再关心"有谁"。
    写法参考了同类高校战队的团队页：先讲定位与方向，再讲参加什么比赛。
  */}
  <section class="team-intro" aria-label="团队介绍">
    <h2 class="team-intro-title">团队介绍</h2>
    <p class="team-intro-text">{TEAM_INFO.intro}</p>
    <dl class="team-facts">
      <div>
        <dt>实验组</dt>
        <dd>{TEAM_INFO.name}</dd>
      </div>
      <div>
        <dt>战队名</dt>
        <dd>{TEAM_INFO.teamName}</dd>
      </div>
      <div>
        <dt>所属单位</dt>
        <dd>{TEAM_INFO.school}</dd>
      </div>
    </dl>
  </section>

  {/*
    团队公告。
    对应同类站点的「通知公告」栏目：发布获奖报道、赛事动态这类时效内容。
    与「荣誉历史」的分工：那边是结构化战绩（一条一个名次），
    这边是可长可短的报道。数据为空时给说明而不是留白。
  */}
  <section class="team-notices" aria-label="团队公告">
    <div class="list-head">
      <h2>团队公告</h2>
      {notices.length > 0 && <span class="count">{notices.length} 条</span>}
    </div>

    {
      notices.length > 0 ? (
        <ul class="notice-list">
          {notices.map((n) => (
            <li class="notice-item">
              <div class="notice-head">
                {n.tag && <span class="notice-tag">{n.tag}</span>}
                <h3 class="notice-title">
                  {n.url ? (
                    <a href={n.url} target="_blank" rel="noopener noreferrer">{n.title}</a>
                  ) : (
                    n.title
                  )}
                </h3>
                <time class="notice-date" datetime={n.date}>
                  {formatDate(new Date(n.date), 'long')}
                </time>
              </div>
              {n.body && <p class="notice-body">{n.body}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice-empty">暂时还没有公告。</p>
      )
    }
  </section>


  {
    total === 0 ? (
      <div class="empty-state">
        <p class="empty-title">成员信息整理中</p>
        <p>名单还没放上来，稍后再来看看。</p>
      </div>
    ) : (
      groups.map((group) => (
        <section class="team-section" aria-label={group.meta.name}>
          <div class="list-head">
            <h2>{group.meta.name}</h2>
            <span class="count">{group.items.length} 人</span>
          </div>
          {group.meta.desc && <p class="team-section-desc">{group.meta.desc}</p>}

          <ul class="team-grid">
            {group.items.map((m: TeamMember) => {
              const written = postCountFor(m);
              return (
                <li class="team-card">
                  <div class="team-head">
                    {m.avatar ? (
                      <img
                        class="team-avatar"
                        src={withBase(m.avatar)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        data-initial={m.name.trim().charAt(0)}
                      />
                    ) : (
                      <span class="team-avatar is-initial" aria-hidden="true">
                        {m.name.trim().charAt(0)}
                      </span>
                    )}
                    <div class="team-id">
                      <h3 class="team-name">
                        <span>{m.name}</span>
                        {m.handle && <span class="team-handle">@{m.handle}</span>}
                      </h3>
                      <p class="team-meta">
                        {m.title}
                        {m.title && m.year && <span class="team-meta-sep">·</span>}
                        {m.year && <span>{m.year} 届</span>}
                      </p>
                      {m.honors && m.honors.length > 0 && (
                        <p class="team-honors">
                          {m.honors.map((h) => (
                            <span class="team-honor">{h}</span>
                          ))}
                        </p>
                      )}
                    </div>
                  </div>

                  {m.focus && m.focus.length > 0 && (
                    <div class="post-tags team-focus">
                      {m.focus.map((f) => (
                        <a class="tag" href={withBase(`/tags/${f}/`)}>#{f}</a>
                      ))}
                    </div>
                  )}

                  {m.bio && <p class="team-bio">{m.bio}</p>}

                  {(written > 0 || (m.links && m.links.length > 0)) && (
                    <div class="team-links">
                      {written > 0 && (
                        <a class="team-written" href={withBase('/archive/')}>
                          本站文章 {written} 篇
                        </a>
                      )}
                      {m.links?.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener noreferrer">
                          {l.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    )
  }

  {/*
    招新信息。
    只在 RECRUITMENT.enabled 为 true 时渲染 ——
    没有真实招新通道时挂一个点不动的「加入我们」比不挂更糟。
  */}
  {
    RECRUITMENT.enabled && (
      <section class="team-section recruit" aria-label="加入我们">
        <div class="list-head">
          <h2>加入我们</h2>
        </div>
        {RECRUITMENT.headline && <p class="recruit-headline">{RECRUITMENT.headline}</p>}

        {RECRUITMENT.tracks.length > 0 && (
          <div class="post-tags recruit-tracks">
            {RECRUITMENT.tracks.map((t) => (
              <span class="tag">#{t}</span>
            ))}
          </div>
        )}

        {RECRUITMENT.who && <p class="recruit-who">面向：{RECRUITMENT.who}</p>}

        {RECRUITMENT.steps.length > 0 && (
          <ol class="recruit-steps">
            {RECRUITMENT.steps.map((s) => (
              <li>{s}</li>
            ))}
          </ol>
        )}

        {RECRUITMENT.contacts.length > 0 && (
          <dl class="recruit-contacts">
            {RECRUITMENT.contacts.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>
                  {c.href ? (
                    <a href={c.href} target="_blank" rel="noopener noreferrer">{c.value}</a>
                  ) : (
                    c.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    )
  }
</Layout>

<script is:inline>
  /*
    头像加载失败时退回姓名首字。
    为什么需要：团队页最常见的坏点就是头像 —— 图片挂在第三方图床，
    图床关站后整页变成一排破图（某高校团队页实测 99 张图里坏了 30 张）。
    这里不给它坏的机会：失败就把 img 换成一个首字方块。
  */
  document.querySelectorAll('img.team-avatar').forEach(function (img) {
    img.addEventListener('error', function () {
      var span = document.createElement('span');
      span.className = 'team-avatar is-initial';
      span.setAttribute('aria-hidden', 'true');
      span.textContent = img.getAttribute('data-initial') || '?';
      img.replaceWith(span);
    });
  });
</script>

<style>
  .team-section {
    margin-top: 2.2rem;
  }

  /* ── 团队介绍 ── */
  .team-intro {
    margin-top: 0.5rem;
    padding: 1.3rem 1.4rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .team-intro-title {
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
  }

  .team-intro-text {
    margin: 0;
    line-height: 1.85;
  }

  /* 队伍名称与所属单位：用两列小字典，扫一眼就知道是谁 */
  .team-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 1.1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .team-facts dt {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .team-facts dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  /* ── 团队公告 ── */
  .team-notices {
    margin-top: 2.4rem;
  }

  .notice-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notice-item {
    padding: 1rem 1.2rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .notice-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.7rem;
  }

  .notice-tag {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.76rem;
    line-height: 1.6;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    flex-shrink: 0;
  }

  .notice-title {
    margin: 0;
    font-size: 1rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .notice-date {
    font-size: 0.84rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .notice-body {
    margin: 0.6rem 0 0;
    font-size: 0.94rem;
    line-height: 1.8;
  }

  .notice-empty {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .team-section-desc {
    margin: 0.3rem 0 1rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .team-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .team-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .team-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  /* 无头像、或头像加载失败时的首字占位。
     不同人天然不同字，比一张通用剪影更有区分度。 */
  .team-avatar.is-initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1;
  }

  .team-id {
    min-width: 0;
  }

  .team-name {
    margin: 0;
    font-size: 1.02rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .team-handle {
    font-size: 0.84rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .team-meta {
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .team-meta-sep {
    margin-inline: 0.3rem;
    opacity: 0.6;
  }

  /* 荣誉称号：小徽章，用强调色与普通身份文字区分开 */
  .team-honors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.35rem 0 0;
  }

  .team-honor {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.76rem;
    line-height: 1.5;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  .team-focus {
    margin: 0;
  }

  .team-bio {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .team-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.88rem;
    margin-top: auto;
  }

  /* 站内文章入口用强调色，与外部链接区分开 */
  .team-written {
    color: var(--accent);
  }

  .empty-sub {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* ── 招新区块（仅在 RECRUITMENT.enabled 时渲染） ── */
  .recruit-headline {
    margin: 0.3rem 0 0.9rem;
    font-size: 1.02rem;
  }

  .recruit-tracks {
    margin-bottom: 0.8rem;
  }

  .recruit-who {
    margin: 0 0 0.9rem;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .recruit-steps {
    margin: 0 0 1.1rem;
    padding-inline-start: 1.3rem;
    line-height: 1.8;
  }

  .recruit-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin: 0;
  }

  .recruit-contacts dt {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .recruit-contacts dd {
    margin: 0.1rem 0 0;
  }
</style>
