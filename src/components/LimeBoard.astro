---
/**
 * 首页「课堂排行榜」。
 *
 * 首屏读构建时的 src/data/lime-leaderboard.json（兜底快照）；
 * 浏览器通过 ntfy 的 SSE 长连接接收教师机推送的签名数据，变化后 1~2 秒到页面。
 *
 * 为什么不用 GitHub raw / Pages：
 *   Pages 是静态托管，同源文件更新要重新部署（约 1 分钟）；
 *   raw 和加速节点有 5 分钟 CDN 缓存，实测做不到实时。
 *   ntfy 的 SSE 是长连接、支持 CORS、不需要账号，适合课堂这种短时高频更新。
 *
 * 安全：topic 名会出现在页面源码里，任何人都能往里发消息；页面只接受
 * 教师机 ECDSA 私钥签名的信封，验签失败直接丢弃，伪造的榜单不会上屏。
 */
import { withBase } from '../utils/url';
import board from '../data/lime-leaderboard.json';

interface Player {
  rank: number;
  nickname: string;
  username: string;
  score: number;
  solved: number;
  firstBloods: number;
  lastSolvedAt: string | null;
}

const players: Player[] = Array.isArray(board.players) ? board.players : [];
const top = players.slice(0, 5);
const totalSolves = players.reduce((n, p) => n + p.solved, 0);
const playerCount = Number(board.playerCount) || players.length;
const solveCount = Number(board.solveCount) || totalSolves;

/**
 * ntfy 实时通道与验签公钥。
 * 私钥在教师机的 _tools/lab-secrets/live-board-key.json，不在仓库里；
 * 换密钥时把 scripts/live-board.mjs 生成的公钥同步改到这里。
 */
const NTFY_SERVER = 'https://ntfy.sh';
const NTFY_TOPIC = 'limefeiyu-board-c3375f08e2a0';
const LIVE_PUBLIC_KEY =
  'MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEqCKw4mO2EjIjrXn87n8qmlScFDEyCok8CzBXCN4qLM7zCUYswlWhJ43Dv+83mqjzXUMW+GimeDRXrHFVVZGYcA==';

/** 按北京时间显示成 2026-10-22 15:30，避免观众所在时区影响。 */
function formatStamp(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const parts = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const pick = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
  return `${pick('year')}-${pick('month')}-${pick('day')} ${pick('hour')}:${pick('minute')}`;
}

const stamp = formatStamp(board.generatedAt);
---

<section
  class="lime-board"
  data-lime-board
  data-ntfy-server={NTFY_SERVER}
  data-ntfy-topic={NTFY_TOPIC}
  data-public-key={LIVE_PUBLIC_KEY}
  aria-labelledby="lime-board-title"
>
  <div class="lime-board-head">
    <div>
      <h2 id="lime-board-title" class="lime-board-title">
        课堂排行榜
        <span class="lime-board-kicker">LIMECTF</span>
      </h2>
      <p class="lime-board-sub">
        青柠商城靶场 ·
        <span data-lime-players>{playerCount}</span> 位选手 ·
        <span data-lime-solves>{solveCount}</span> 次解出
      </p>
    </div>
    <div class="lime-board-side">
      <span class="lime-live is-pending" data-lime-live>
        <i class="lime-live-dot" aria-hidden="true"></i>
        <span data-lime-status>连接中…</span>
      </span>
      <a class="lime-board-link" href={withBase('/lime-lab/')}>
        靶场详情<span aria-hidden="true"> →</span>
      </a>
    </div>
  </div>

  <table class="lime-board-table">
    <thead>
      <tr>
        <th scope="col" class="col-rank">#</th>
        <th scope="col">选手</th>
        <th scope="col" class="col-num">解出</th>
        <th scope="col" class="col-num">得分</th>
        <th scope="col" class="col-last">最后解出</th>
      </tr>
    </thead>
    <tbody data-lime-rows>
      {
        top.length > 0 ? (
          top.map((p) => (
            <tr>
              <td class={`col-rank rank-${p.rank}`}>{p.rank}</td>
              <td class="col-who">
                <span class="nick">{p.nickname}</span>
                <span class="handle">@{p.username}</span>
                {p.firstBloods > 0 && <span class="fb">一血 ×{p.firstBloods}</span>}
              </td>
              <td class="col-num solved">{p.solved} 题</td>
              <td class="col-num score">{p.score}</td>
              <td class="col-last">{p.lastSolvedAt ?? '—'}</td>
            </tr>
          ))
        ) : (
          <tr>
            <td colspan="5" class="lime-board-empty">排行榜还没有数据，课堂开始后会在这里更新。</td>
          </tr>
        )
      }
    </tbody>
  </table>

  <p class="lime-board-foot">
    <span>数据更新于 <time data-lime-stamp>{stamp}</time></span>
    <span class="lime-board-note">
      <span data-lime-sync>正在连接实时数据…</span>
      · 完整榜单见靶场页
    </span>
  </p>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-lime-board]');
    if (!root) return;

    const tbody = root.querySelector('[data-lime-rows]');
    const statusEl = root.querySelector('[data-lime-live]');
    const statusText = root.querySelector('[data-lime-status]');
    const syncText = root.querySelector('[data-lime-sync]');
    const stampEl = root.querySelector('[data-lime-stamp]');
    const playersEl = root.querySelector('[data-lime-players]');
    const solvesEl = root.querySelector('[data-lime-solves]');

    const server = (root.dataset.ntfyServer || '').replace(/\/+$/, '');
    const topic = root.dataset.ntfyTopic || '';
    const publicKeyB64 = root.dataset.publicKey || '';
    if (!server || !topic || !publicKeyB64 || !tbody) return;

    const MAX_ROWS = 5;
    const POLL_MS = 10000;

    /* Astro 的 scoped CSS 靠 data-astro-cid-* 属性匹配；JS 新建的行没有这个属性，
       样式会整块掉光（名次不变色、时间不 nowrap）。把根节点的 scope 属性复制过去。 */
    const scopeAttrs = Array.from(root.attributes).filter((a) => a.name.startsWith('data-astro-cid-'));
    function scoped(el) {
      for (const attr of scopeAttrs) el.setAttribute(attr.name, attr.value);
      return el;
    }

    let verifyKey = null;
    let lastSync = null;
    let lastScores = new Map();
    let eventSource = null;
    let pollTimer = null;
    let polling = false;
    let errorCount = 0;
    let chain = Promise.resolve();

    const text = (v) => String(v == null ? '' : v);
    const num = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0);

    function b64ToBytes(b64) {
      const bin = atob(b64);
      const out = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i += 1) out[i] = bin.charCodeAt(i);
      return out;
    }

    function b64urlToBytes(s) {
      let v = String(s).replace(/-/g, '+').replace(/_/g, '/');
      const pad = v.length % 4;
      if (pad) v += '='.repeat(4 - pad);
      return b64ToBytes(v);
    }

    function formatStamp(iso) {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return text(iso);
      const parts = new Intl.DateTimeFormat('zh-CN', {
        timeZone: 'Asia/Shanghai',
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false,
      }).formatToParts(d);
      const pick = (t) => (parts.find((p) => p.type === t) || {}).value || '';
      return pick('year') + '-' + pick('month') + '-' + pick('day') + ' ' + pick('hour') + ':' + pick('minute');
    }

    function formatClock(d) {
      return d.toLocaleTimeString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });
    }

    function setStatus(state, label) {
      statusEl.classList.remove('is-pending', 'is-live', 'is-offline');
      statusEl.classList.add(state);
      statusText.textContent = label;
    }

    function normalize(data) {
      if (!data || !Array.isArray(data.players)) return null;
      const players = data.players
        .slice(0, MAX_ROWS)
        .map((p, i) => ({
          rank: num(p.rank) || i + 1,
          nickname: text(p.nickname || p.username).slice(0, 40),
          username: text(p.username).slice(0, 40),
          score: num(p.score),
          solved: num(p.solved),
          firstBloods: num(p.firstBloods),
          lastSolvedAt: p.lastSolvedAt ? text(p.lastSolvedAt).slice(0, 30) : null,
        }))
        .filter((p) => p.username);
      return {
        generatedAt: text(data.generatedAt),
        playerCount: num(data.playerCount) || players.length,
        solveCount: num(data.solveCount) || players.reduce((n, p) => n + p.solved, 0),
        players,
      };
    }

    function cell(className, value) {
      const td = scoped(document.createElement('td'));
      td.className = className;
      td.textContent = value;
      return td;
    }

    function rowFor(player, isNew) {
      const tr = scoped(document.createElement('tr'));
      if (isNew) tr.className = 'is-updated';

      const rank = scoped(document.createElement('td'));
      rank.className = 'col-rank rank-' + player.rank;
      rank.textContent = String(player.rank);
      tr.appendChild(rank);

      const who = scoped(document.createElement('td'));
      who.className = 'col-who';
      const nick = scoped(document.createElement('span'));
      nick.className = 'nick';
      nick.textContent = player.nickname;
      const handle = scoped(document.createElement('span'));
      handle.className = 'handle';
      handle.textContent = '@' + player.username;
      who.appendChild(nick);
      who.appendChild(handle);
      if (player.firstBloods > 0) {
        const fb = scoped(document.createElement('span'));
        fb.className = 'fb';
        fb.textContent = '一血 ×' + player.firstBloods;
        who.appendChild(fb);
      }
      tr.appendChild(who);

      tr.appendChild(cell('col-num solved', player.solved + ' 题'));
      tr.appendChild(cell('col-num score', String(player.score)));
      tr.appendChild(cell('col-last', player.lastSolvedAt || '—'));
      return tr;
    }

    function render(data) {
      const fragment = document.createDocumentFragment();
      if (data.players.length === 0) {
        const tr = scoped(document.createElement('tr'));
        const td = cell('lime-board-empty', '排行榜还没有数据，课堂开始后会在这里更新。');
        td.colSpan = 5;
        tr.appendChild(td);
        fragment.appendChild(tr);
      } else {
        data.players.forEach((p) => {
          const before = lastScores.get(p.username);
          const isNew = before !== undefined && p.score > before;
          fragment.appendChild(rowFor(p, isNew));
        });
      }
      tbody.replaceChildren(fragment);

      playersEl.textContent = String(data.playerCount);
      solvesEl.textContent = String(data.solveCount);
      stampEl.textContent = formatStamp(data.generatedAt);

      lastScores = new Map(data.players.map((p) => [p.username, p.score]));
      lastSync = new Date();
      root.classList.remove('is-offline');
      setStatus('is-live', '实时同步');
      syncText.textContent = '最近同步 ' + formatClock(lastSync);
    }

    async function setupKey() {
      try {
        verifyKey = await crypto.subtle.importKey(
          'spki',
          b64ToBytes(publicKeyB64),
          { name: 'ECDSA', namedCurve: 'P-256' },
          false,
          ['verify'],
        );
      } catch (e) {
        setStatus('is-offline', '验签不可用');
      }
    }

    async function handleEnvelope(raw) {
      if (!verifyKey) return;
      let envelope;
      try {
        envelope = JSON.parse(raw);
      } catch (e) {
        return;
      }
      if (!envelope || envelope.v !== 1 || !envelope.d || !envelope.s) return;

      const dataBytes = b64urlToBytes(envelope.d);
      const sigBytes = b64urlToBytes(envelope.s);
      let ok = false;
      try {
        ok = await crypto.subtle.verify(
          { name: 'ECDSA', hash: 'SHA-256' },
          verifyKey,
          sigBytes,
          dataBytes,
        );
      } catch (e) {
        ok = false;
      }
      if (!ok) return;

      let payload;
      try {
        payload = JSON.parse(new TextDecoder().decode(dataBytes));
      } catch (e) {
        return;
      }
      const data = normalize(payload);
      if (data) render(data);
    }

    /* 消息串行处理，避免快速连发时旧消息后到覆盖新榜单 */
    function handleEvent(raw) {
      chain = chain
        .then(async () => {
          let evt;
          try {
            evt = JSON.parse(raw);
          } catch (e) {
            return;
          }
          if (!evt || evt.event !== 'message' || !evt.message) return;
          await handleEnvelope(evt.message);
        })
        .catch(() => {});
      return chain;
    }

    /* SSE 被网络中间层掐掉时的兜底：每 10 秒轮询一次 ntfy 的 JSON 接口 */
    function startPolling() {
      if (polling) return;
      polling = true;
      let since = '30m';
      const tick = async () => {
        try {
          const res = await fetch(
            server + '/' + encodeURIComponent(topic) + '/json?poll=1&since=' + since,
            { cache: 'no-store' },
          );
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const body = await res.text();
          for (const line of body.split('\n')) {
            if (!line.trim()) continue;
            let evt;
            try {
              evt = JSON.parse(line);
            } catch (e) {
              continue;
            }
            if (evt.id) since = evt.id;
            await handleEvent(line);
          }
          setStatus('is-live', '实时同步');
          if (!lastSync) syncText.textContent = '已连接，等待更新';
        } catch (e) {
          setStatus('is-offline', '同步中断');
        }
        pollTimer = setTimeout(tick, POLL_MS);
      };
      tick();
    }

    function stopPolling() {
      polling = false;
      clearTimeout(pollTimer);
    }

    function connect() {
      if (!('EventSource' in window)) {
        startPolling();
        return;
      }
      try {
        eventSource = new EventSource(
          server + '/' + encodeURIComponent(topic) + '/sse?since=30m',
        );
      } catch (e) {
        startPolling();
        return;
      }

      eventSource.onopen = () => {
        errorCount = 0;
        stopPolling();
        setStatus('is-live', '实时同步');
        if (!lastSync) syncText.textContent = '已连接，等待更新';
      };

      eventSource.onmessage = (event) => {
        handleEvent(event.data);
      };

      eventSource.onerror = () => {
        errorCount += 1;
        setStatus('is-offline', '重连中…');
        /* 连续失败 3 次才切轮询，避免一次网络抖动就永久降级 */
        if (errorCount >= 3) startPolling();
      };
    }

    setupKey().then(() => {
      if (verifyKey) connect();
    });
  })();
</script>

<style>
  .lime-board {
    /* 第 1～3 名的奖牌色：浅色主题用深一档，深色主题在下面覆盖 */
    --medal-1: #b45309;
    --medal-2: #64748b;
    --medal-3: #9a3412;

    margin: 0 0 2.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  :global(:root[data-theme='dark']) .lime-board {
    --medal-1: #fbbf24;
    --medal-2: #cbd5e1;
    --medal-3: #fb923c;
  }

  .lime-board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem 0.7rem;
  }

  .lime-board-title {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .lime-board-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .lime-board-sub {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .lime-board-side {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.1rem;
  }

  .lime-board-link {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .lime-board-link:hover {
    color: var(--accent);
  }

  /* 「实时同步」状态：连接中 / 已连接 / 中断三态 */
  .lime-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--text-faint);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .lime-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .lime-live.is-live {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .lime-live.is-live .lime-live-dot {
    animation: lime-pulse 1.8s ease-out infinite;
  }

  .lime-live.is-offline {
    color: #d97706;
    border-color: color-mix(in srgb, #d97706 40%, transparent);
  }

  @keyframes lime-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 6px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .lime-board-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;

    th {
      padding: 0.55rem 1.25rem;
      border-top: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--text-faint);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-align: left;
      white-space: nowrap;
    }

    td {
      padding: 0.62rem 1.25rem;
      border-top: 1px solid var(--border);
      vertical-align: middle;
    }

    tbody tr:hover {
      background: var(--bg-subtle);
    }
  }

  /* 新解出的一行短暂高亮，让「实时」有可见的反馈 */
  .lime-board-table tbody tr.is-updated {
    animation: lime-row-flash 2.4s var(--ease-out);
  }

  @keyframes lime-row-flash {
    0% {
      background: var(--accent-soft);
    }
    100% {
      background: transparent;
    }
  }

  .col-rank {
    width: 3.2rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  td.col-rank {
    font-weight: 700;
  }

  .rank-1 {
    color: var(--medal-1);
  }

  .rank-2 {
    color: var(--medal-2);
  }

  .rank-3 {
    color: var(--medal-3);
  }

  .nick {
    font-weight: 600;
  }

  .handle {
    margin-left: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  .fb {
    display: inline-block;
    margin-left: 0.55rem;
    padding: 0.02rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .col-num {
    text-align: right;
    white-space: nowrap;
  }

  .solved {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .score {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .col-last {
    width: 10.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .lime-board-empty {
    padding: 1.6rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    text-align: center;
  }

  .lime-board-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0.65rem 1.25rem 0.8rem;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.73rem;
  }

  .lime-board-note {
    opacity: 0.85;
  }

  @media (width <= 640px) {
    .lime-board-head {
      padding: 1rem 1rem 0.6rem;
    }

    .lime-board-side {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.35rem;
    }

    .lime-board-table {
      font-size: 0.84rem;

      th,
      td {
        padding-inline: 0.8rem;
      }
    }

    .col-last {
      display: none;
    }

    .handle {
      display: none;
    }

    .lime-board-foot {
      padding-inline: 0.8rem;
    }
  }
</style>
