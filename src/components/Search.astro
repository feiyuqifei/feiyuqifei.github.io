---
/**
 * 全站搜索（Pagefind Component UI）。
 *
 * 工作原理：Pagefind 在 astro build 之后扫描 dist/ 生成静态索引，
 * 由 astro-pagefind 集成自动接线，无需手写构建步骤。
 *
 * 两个必须注意的点：
 *  1. Pagefind 的资源（/pagefind/*）只在构建产物里存在，
 *     `astro dev` 下不存在。所以开发环境隐藏搜索按钮，
 *     否则会得到一个点了没反应的按钮。要看搜索必须 build + preview。
 *  2. Pagefind 组件自带独立的"影子"样式体系，通过 --pf-* 变量取色，
 *     相关主题映射统一写在 Layout.astro 里（因为它挂在 <html> 层级）。
 */

// astro-pagefind 只在生产构建时注入 /pagefind/* 资源
const isDev = import.meta.env.DEV;
---

{
  !isDev && (
    <>
      <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
      <pagefind-modal-trigger>
        <button class="search-trigger" type="button" aria-label="搜索全站内容">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <span class="search-trigger-text">搜索</span>
          <kbd>/</kbd>
        </button>
      </pagefind-modal-trigger>
      <pagefind-modal reset-on-close />
      <script src="/pagefind/pagefind-component-ui.js" type="module" is:inline />
    </>
  )
}
