---
/**
 * 标签总览页：展示全部标签及各自文章数。
 * 标签名可能是中文，路径里直接使用原始名称（Astro 构建时统一编码）。
 */
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/url';
import { getPublishedPosts } from '../../utils/render-posts';
import { collectTags } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<Layout title="标签" description="按标签浏览全部文章">
  <header class="page-head">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={withBase('/')}>首页</a>
      <span> / </span>
      <span>标签</span>
    </nav>
    <h1>标签</h1>
    <p class="page-desc">共 {tags.length} 个标签，{posts.length} 篇文章。</p>
  </header>

  {
    tags.length > 0 ? (
      <div class="tag-cloud">
        {tags.map((item) => (
          <a class="tag" href={withBase(`/tags/${item.tag}/`)}>
            #{item.tag}
            <span class="tag-count">{item.count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">还没有任何标签。</p>
    )
  }
</Layout>
